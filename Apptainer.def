Bootstrap: oras
From: ghcr.io/g4med-test/geant4-alma9:{{ TAG }}

# The base image provides Geant4 (/opt/geant4), compilers, CMake and Python with
# NumPy/uproot (/opt/venv), and already sets PATH, LD_LIBRARY_PATH and the
# dataset variables (/g4data).
#
# This test is driven by GATE macros, so instead of compiling a Geant4 main
# the image builds GATE (the C++, macro-driven GATE 9: OpenGATE/Gate, not the
# Python opengate 10) from the GATE_TAG release against the Geant4 of the base
# image. GATE writes its listmode output with ROOT, taken from EPEL (ROOT 6.40,
# built with -std=c++17 like Geant4 11).
#
# Each GATE release targets one Geant4 minor version: v9.4.2 needs Geant4 11.4
# (it does not compile with 11.3, e.g. G4QuasiOpticalPhoton), v9.4/v9.4.1 are
# for 11.2. Hence the 11.4 default TAG; change GATE_TAG together with TAG.
%arguments
    TAG=v11.4.3
    PROJECT_NAME=G4TestGeneric
    GATE_TAG=v9.4.2

%labels
    Project {{ PROJECT_NAME }}
    Description "Apptainer container for {{ PROJECT_NAME }}"
    GateVersion {{ GATE_TAG }}

%files
    validation/scripts/GateMaterials.db /opt/gate/share/GateMaterials.db

%post
    set -eu
    dnf install -y --setopt=install_weak_deps=False epel-release dnf-plugins-core
    dnf config-manager --set-enabled crb
    # root-core pulls in every library of ROOT's default ROOT_LIBRARIES, which
    # GATE links against.
    dnf install -y --setopt=install_weak_deps=False root-core libxml2-devel
    dnf clean all
    rm -rf /var/cache/dnf

    # analyse_pet.py (run by validation/parser.py) also needs these.
    /opt/venv/bin/python -m pip install --no-cache-dir --only-binary=:all: matplotlib scipy

    mkdir -p /tmp/gate/src
    curl -fLsS --retry 5 \
        'https://codeload.github.com/OpenGATE/Gate/tar.gz/refs/tags/{{ GATE_TAG }}' \
        -o /tmp/gate/source.tar.gz
    tar -xzf /tmp/gate/source.tar.gz -C /tmp/gate/src --strip-components=1
    cmake -S /tmp/gate/src -B /tmp/gate/build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/gate \
        -DCMAKE_PREFIX_PATH=/opt/geant4 \
        -DGATE_USE_GEANT4_UIVIS=OFF
    cmake --build /tmp/gate/build --parallel "$(nproc)"
    cmake --install /tmp/gate/build
    rm -rf /tmp/gate

%environment
    export PATH=/opt/gate/bin:$PATH

# GATE resolves the macro's data/GateMaterials.db and output/ against the working
# directory (an empty /outputs in the validation run), so both are prepared there.
# Output is line-buffered so that the last messages before an abort (a fatal
# G4Exception) still reach the log instead of being lost in the stdio buffer.
%runscript
    mkdir -p output data
    [ -e data/GateMaterials.db ] || ln -s /opt/gate/share/GateMaterials.db data/GateMaterials.db
    exec stdbuf -oL -eL /opt/gate/bin/Gate "$@"

%test
    set -eu
    test -x /opt/gate/bin/Gate
    /opt/venv/bin/python -c 'import matplotlib, scipy, uproot'
